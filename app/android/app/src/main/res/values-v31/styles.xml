<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ draws its own splash: Noir black behind the icon instead of white ([QA] S8 #9) -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/noir_bg</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/noir_bg</item>
    </style>
</resources>
