{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mafia-dealer-game",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mafia-dealer-game",
      "database_id": "068e94a4-cd09-4c78-ba82-5645fc588a69",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "HUB", "class_name": "Hub" }
    ]
  },
  // the free plan needs SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Hub"] }],
  // hourly: expire Wi-Fi requests nobody finished confirming (src/wifi.ts)
  "triggers": { "crons": ["23 * * * *"] },
  "vars": {
    // Google OAuth client ids allowed as the sign-in token's audience (comma-separated; the Web client id)
    "GOOGLE_CLIENT_IDS": "347831426258-e0guv95d25aq2adumf8cbvl8grf347qc.apps.googleusercontent.com",
    "MAIL_FROM": "Mafia Dealer <login@mafiadealer.app>"
  }
  // secrets (wrangler secret put): RESEND_API_KEY, ADMIN_IDS, FCM_SERVICE_ACCOUNT
}
